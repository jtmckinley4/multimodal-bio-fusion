#!/usr/bin/env bash
# Submit only the agreed workload from a NEW prepared workspace. Supply account,
# partition, GPU, CPU, RAM and time limits through approved sbatch options.
#SBATCH --job-name=grouped-stability
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --output=outputs/logs/grouped-%A_%a.out
#SBATCH --error=outputs/logs/grouped-%A_%a.err

set -euo pipefail
: "${SLURM_JOB_ID:?Training requires an allocated Slurm job}"
: "${ARCC_PROJECT_ROOT:?Absolute path to the NEW grouped-stability workspace}"
: "${ARCC_ANACONDA_MODULE:?Module confirmed on Newton}"
: "${ARCC_CONDA_ENV:?Prepared environment name or absolute path}"
: "${ARCC_KERNEL:?Kernel registered in that environment}"
: "${ARCC_EXPECTED_GPU:?GPU-name substring confirmed by preflight}"
: "${ARCC_CACHE_ROOT:?Absolute existing cache root; arrays are reused, not copied}"
cd "$ARCC_PROJECT_ROOT"
printf 'Preparing Conda environment on %s\n' "$(hostname)"
# Initialize inherited Conda before module loading can attempt to deactivate it.
if (( ${CONDA_SHLVL:-0} > 0 )); then
    ARCC_BOOTSTRAP_CONDA_BASE=$(conda info --base)
    source "$ARCC_BOOTSTRAP_CONDA_BASE/etc/profile.d/conda.sh"
fi
module load "$ARCC_ANACONDA_MODULE"
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$ARCC_CONDA_ENV"
printf 'Using Python: %s\n' "$(command -v python)"
python -u run_grouped_stability.py --verify-only

ARCC_OUTPUT_ROOT="${ARCC_OUTPUT_ROOT:-$ARCC_PROJECT_ROOT/outputs}"
[[ -d "$ARCC_OUTPUT_ROOT/logs" ]] || {
    echo "Prepare the selected logs directory before submission." >&2; exit 2;
}
seed="${SLURM_ARRAY_TASK_ID:-${ARCC_SEED:-}}"
[[ "$seed" =~ ^[012]$ ]] || { echo "Select exactly one seed: 0, 1 or 2." >&2; exit 2; }
printf 'Starting grouped stability seed %s: 12 declared fits.\n' "$seed"
python -m pip freeze > "$ARCC_OUTPUT_ROOT/logs/environment-${SLURM_JOB_ID}-seed${seed}.txt"
python -u run_grouped_stability.py --seed "$seed" --kernel "$ARCC_KERNEL" \
    --expected-gpu "$ARCC_EXPECTED_GPU" --cache-root "$ARCC_CACHE_ROOT" \
    --output-root "$ARCC_OUTPUT_ROOT"
