# macOS
.DS_Store

# Python / notebooks
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Office lock files
**/~$*

# Claude app output mirror
Claude outputs/

# model cache
.model-cache/

# Downloaded source data for Code/stage1/build_gtex_pilot.py
.data-cache/

# Locally generated embeddings: Stage 1 caches, and any token-level embeddings
# kept outside cluster scratch by later stages
/Code/*/embeddings/
/Code/*/embeddings_legacy/

# Training checkpoints: ~100 MB each, and the JSON result beside them is the record.
# Matched anywhere, because results are nested one level per benchmark.
*.checkpoint
*.checkpoint.partial
# Pre-October 15 locations, in case an older checkout still has them
/Code/stage1_main_embeddings.npz
/Code/stage1_multimodel_embeddings/
/Code/stage1_embeddings/
/Code/stage1_embeddings_legacy/

# R history
.Rhistory

# Fitted weights and interrupted publications stay local; completed result JSONs are tracked.
/Code/*/results/**/*.weights.pt
/Code/*/results/**/*.weights.pt.*.partial
/Code/*/results/**/*.json.*.partial
