# macOS
.DS_Store

# Python / notebooks
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Office lock files
**/~$*

# Claude app output mirror
Claude outputs/

# model cache
.model-cache/

# Downloaded source data for Code/stage1/build_gtex_pilot.py
.data-cache/

# Locally generated embeddings: Stage 1 caches, and any token-level embeddings
# kept outside cluster scratch by later stages
/Code/*/embeddings/
/Code/*/embeddings_legacy/

# Training checkpoints: ~100 MB each, and the JSON result beside them is the record.
# Matched anywhere, because results are nested one level per benchmark.
*.checkpoint
*.checkpoint.partial
# Pre-October 15 locations, in case an older checkout still has them
/Code/stage1_main_embeddings.npz
/Code/stage1_multimodel_embeddings/
/Code/stage1_embeddings/
/Code/stage1_embeddings_legacy/

# R history
.Rhistory

# Fitted weights and interrupted publications stay local; completed result JSONs are tracked.
/Code/*/results/**/*.weights.pt
/Code/*/results/**/*.weights.pt.*.partial
/Code/*/results/**/*.json.*.partial

# Personal deferred reference work stays local, including its navigation notes.
/Code/deferred/

# Returned Newton inputs are verified against the canonical CSVs in /datasets/.
# Keep accidental return-transfer duplicates out of the shared results package.
/Code/stage4/results/newton_h100_seeds012/datasets/

# Stage 4 partner tasks: entity embedding caches, which are derived and over a gigabyte.
# Rebuild them with partner_tasks.ipynb at RUN_EXTRACTION = True; they depend only on the
# built tables and the encoder revision, both of which are recorded.
# The built tables themselves (Code/stage4/data/pairs, 31 MB) ARE tracked: rebuilding them
# needs external downloads (RPIMotif, Harvard Dataverse 5219748 and 5255037, GSE60143 with
# TAIR10) that can change under us, and the tables are the scientific artifact.
/Code/stage4/cache/
